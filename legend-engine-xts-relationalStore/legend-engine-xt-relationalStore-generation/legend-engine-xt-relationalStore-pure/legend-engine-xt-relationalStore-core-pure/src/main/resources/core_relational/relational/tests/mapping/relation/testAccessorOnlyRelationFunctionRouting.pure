function meta::relational::tests::mapping::relation::accessorOnly::firmAccessorOnlyFunction():Relation<(ID:Integer[1], legalName:String[1])>[1]
{
  #>{meta::relational::tests::mapping::relation::testDB.firmTable}#->limit(10)
}

function meta::relational::tests::mapping::relation::accessorOnly::personJoinGroupFunction():Relation<Any>[1]
{
  #>{meta::relational::tests::mapping::relation::testDB.personTable}#
    ->join(#>{meta::relational::tests::mapping::relation::testDB.groupMembershipTable}#, JoinKind.INNER, {p, g | $p.ID == $g.PERSONID})
    ->filter(x | $x.GROUPNAME == 'Group C')
}

