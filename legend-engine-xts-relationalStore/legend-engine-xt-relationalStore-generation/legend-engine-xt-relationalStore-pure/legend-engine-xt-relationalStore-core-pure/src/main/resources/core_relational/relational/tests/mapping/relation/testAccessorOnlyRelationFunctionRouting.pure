}

function meta::relational::tests::mapping::relation::accessorOnly::firmViaHelperFunction():Relation<(ID:Integer[1], legalName:String[1])>[1]
{
  meta::relational::tests::mapping::relation::accessorOnly::firmAccessorOnlyFunction()
