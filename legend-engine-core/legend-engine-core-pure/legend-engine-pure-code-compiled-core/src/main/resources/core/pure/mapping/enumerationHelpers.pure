import meta::pure::mapping::*;

// Bounded (depth-4) include-DAG walk, inlined at each call site.
// We deliberately do NOT factor the walk into a helper that returns
// EnumerationMapping<Any>[*]: when such a helper's result crosses a
// function boundary the router pre-evaluates it and embeds the resulting
// EnumerationMapping instances as InstanceValues in the plan, which the
// Java platform binder cannot serialize
// ("Unhandled value type: meta::pure::mapping::EnumerationMapping" in
// core_external_language_java_generation_expressionGeneration).
// Body must remain a single expression: the router rejects multi-expression
// (let-bound) function bodies at router_routing.pure:558.
function meta::pure::mapping::getSourceEnumValues<T>(mapping: Mapping[1], enumeration: Enumeration<T>[1]): T[*]
{
   $mapping.enumerationMappings
      ->concatenate($mapping.includes.included.enumerationMappings)
      ->concatenate($mapping.includes.included.includes.included.enumerationMappings)
      ->concatenate($mapping.includes.included.includes.included.includes.included.enumerationMappings)
      ->filter(em | $em.enumeration->toOne() == $enumeration)
      ->map(em | $em.enumValueMappings.enum)
      ->cast(@T)
      ->distinct();
}

function meta::pure::mapping::getSourceEnumValuesByName<T>(mapping: Mapping[1], enumeration: Enumeration<T>[1], enumerationMappingName: String[1]): T[*]
{
   $mapping.enumerationMappings
      ->concatenate($mapping.includes.included.enumerationMappings)
      ->concatenate($mapping.includes.included.includes.included.enumerationMappings)
      ->concatenate($mapping.includes.included.includes.included.includes.included.enumerationMappings)
      ->filter(em | ($em.enumeration->toOne() == $enumeration) && ($em.name == $enumerationMappingName))
      ->map(em | $em.enumValueMappings.enum)
      ->cast(@T)
      ->distinct();
}
