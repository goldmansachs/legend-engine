import meta::pure::mapping::*;
import meta::pure::mapping::tests::enumerationHelpers::*;

Enum meta::pure::mapping::tests::enumerationHelpers::Colour { RED, GREEN, BLUE, YELLOW }
Enum meta::pure::mapping::tests::enumerationHelpers::Shape  { SQUARE, CIRCLE }

###Mapping
Mapping meta::pure::mapping::tests::enumerationHelpers::BaseMapping
(
   meta::pure::mapping::tests::enumerationHelpers::Shape: EnumerationMapping ShapeMap
   {
      SQUARE: ['sq', 'square'],
      CIRCLE: ['ci', 'circle']
   }
)

Mapping meta::pure::mapping::tests::enumerationHelpers::ChildMapping
(
   include meta::pure::mapping::tests::enumerationHelpers::BaseMapping

   meta::pure::mapping::tests::enumerationHelpers::Colour: EnumerationMapping ColourMap
   {
      RED:   ['r', 'red'],
      GREEN: ['g', 'green']
   }
)

###Pure
import meta::pure::mapping::*;
import meta::pure::mapping::tests::enumerationHelpers::*;

function <<meta::pure::profiles::test.Test>> meta::pure::mapping::tests::enumerationHelpers::testGetSourceEnumValues_directMapping(): Boolean[1]
{
   assertSameElements([Shape.SQUARE, Shape.CIRCLE], getSourceEnumValues(meta::pure::mapping::tests::enumerationHelpers::BaseMapping, Shape));
}

function <<meta::pure::profiles::test.Test>> meta::pure::mapping::tests::enumerationHelpers::testGetSourceEnumValues_includedMapping(): Boolean[1]
{
   assertSameElements([Shape.SQUARE, Shape.CIRCLE], getSourceEnumValues(meta::pure::mapping::tests::enumerationHelpers::ChildMapping, Shape));
}

function <<meta::pure::profiles::test.Test>> meta::pure::mapping::tests::enumerationHelpers::testGetSourceEnumValues_detectsUnmappedMembers(): Boolean[1]
{
   let mapped  = getSourceEnumValues(meta::pure::mapping::tests::enumerationHelpers::ChildMapping, Colour);
   let missing = Colour->enumValues()->filter(v | !$mapped->contains($v));
   assertSameElements([Colour.RED, Colour.GREEN], $mapped);
   assertSameElements([Colour.BLUE, Colour.YELLOW], $missing);
}

function <<meta::pure::profiles::test.Test>> meta::pure::mapping::tests::enumerationHelpers::testGetSourceEnumValuesByName(): Boolean[1]
{
   assertSameElements([Colour.RED, Colour.GREEN], getSourceEnumValuesByName(meta::pure::mapping::tests::enumerationHelpers::ChildMapping, Colour, 'ColourMap'));
}

function <<meta::pure::profiles::test.Test>> meta::pure::mapping::tests::enumerationHelpers::testAllEnumerationMappings_includesTransitively(): Boolean[1]
{
   assertSameElements(['ShapeMap', 'ColourMap'], allEnumerationMappings(meta::pure::mapping::tests::enumerationHelpers::ChildMapping).name);
}
